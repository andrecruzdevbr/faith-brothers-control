# =============================================================================
# FAITH BROTHERS HUB — Variáveis de ambiente
# =============================================================================
# Copie para .env (desenvolvimento local) ou configure no painel da Vercel
# (produção). NUNCA commite o arquivo .env com valores reais.
# =============================================================================


# -----------------------------------------------------------------------------
# FRONTEND (Vite — obrigatórias no .env local e na Vercel)
# -----------------------------------------------------------------------------
# Onde encontrar: Supabase → Project Settings → API

VITE_SUPABASE_URL="https://SEU-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="SUA_ANON_PUBLIC_KEY"
VITE_SUPABASE_PROJECT_ID="SEU-PROJECT-REF"


# -----------------------------------------------------------------------------
# SUPABASE — Edge Functions (secrets no Dashboard ou via CLI)
# Configurar em: Supabase → Project Settings → Edge Functions → Secrets
# NÃO colocar estas variáveis no .env do frontend / Vercel.
# -----------------------------------------------------------------------------

# Injetadas automaticamente pelo Supabase em alguns ambientes; confirme no deploy:
# SUPABASE_URL="https://SEU-PROJECT-REF.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="SUA_SERVICE_ROLE_KEY"
# SUPABASE_ANON_KEY="SUA_ANON_PUBLIC_KEY"

# CORS — origens permitidas, separadas por vírgula (OBRIGATÓRIO em produção)
# Exemplo: https://faith-brothers.vercel.app,https://www.faithbrothers.com.br
# ALLOWED_ORIGINS=""

# Alternativa ao SUPABASE_ANON_KEY (algumas funções aceitam qualquer um dos dois)
# SUPABASE_PUBLISHABLE_KEY="SUA_ANON_PUBLIC_KEY"


# -----------------------------------------------------------------------------
# ASAAS (cobranças / webhook)
# -----------------------------------------------------------------------------

# ASAAS_API_KEY="SUA_CHAVE_API_ASAAS"
# ASAAS_WEBHOOK_TOKEN="TOKEN_SEGURO_PARA_VALIDAR_WEBHOOK"


# -----------------------------------------------------------------------------
# EVOLUTION API — WhatsApp
# -----------------------------------------------------------------------------

# EVOLUTION_API_URL="https://sua-instancia.evolution-api.com"
# EVOLUTION_API_KEY="SUA_CHAVE_EVOLUTION"
# EVOLUTION_INSTANCE_NAME="nome-da-instancia"


# -----------------------------------------------------------------------------
# CRON (agendador externo — ex.: cron-job.org, GitHub Actions)
# -----------------------------------------------------------------------------

# Segredo compartilhado no header x-cron-secret das funções:
#   - generate-monthly-billings
#   - process-whatsapp-queue
# BILLING_CRON_SECRET="GERE_UM_SEGREDO_FORTE_ALEATORIO"


# -----------------------------------------------------------------------------
# SEED DEV (NUNCA habilitar em produção)
# -----------------------------------------------------------------------------

# ALLOW_DEV_SEED="false"
# SEED_DEV_SECRET="segredo-apenas-para-ambiente-local"
# STAFF_SEED_JSON='[{"name":"Nome","whatsapp":"31999999999","roles":["admin","professor"]}]'
# DEV_DEFAULT_PASSWORD="senha-temporaria-dev"
